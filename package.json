{
  "name": "korean-macro-factor-allocation",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Korean growth-inflation regime forecasting: archived macro vintages, multinomial logit versus LightGBM, and cost-aware ETF allocation",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "acquire": "tsx src/regimes/acquire.ts",
    "register": "tsx src/regimes/study.ts --register",
    "research": "tsx src/regimes/study.ts",
    "verify:research": "tsx src/verifyRegimes.ts",
    "setup:lightgbm": "tsx src/setupLightgbm.ts",
    "check": "pnpm typecheck && pnpm test",
    "report": "tsx src/reporting/regimes.ts",
    "research:prepare": "tsx src/regimes/study.ts --prepare",
    "verify:published": "tsx src/verifyRegimes.ts --public",
    "research:validity": "tsx src/reporting/regimeValidity.ts",
    "research:power": "tsx src/regimes/powerRetry.ts",
    "verify:power": "tsx src/verifyPower.ts",
    "report:power": "tsx src/reporting/powerRetry.ts"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "jstat": "^1.9.6",
    "ml-matrix": "^6.12.1",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
